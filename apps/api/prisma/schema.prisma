datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// GLOBAL TAXONOMY & ENUMS
// ==========================================

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  JOURNALIST
  NGO_MANAGER
  ORGANIZATION_STAFF
  VOLUNTEER
  EMPLOYER
  REGISTERED_USER
  USER
  GUEST
}

enum Status {
  ACTIVE
  DRAFT
  PENDING_REVIEW
  EXPIRED
  ARCHIVED
  TRASHED
}

enum OpportunityType {
  JOB
  GRANT
  SCHOLARSHIP
  VOLUNTEER
  TENDER
}

enum ApplicationMethod {
  EXTERNAL_URL
  EMAIL
  PORTAL
  ORGANIZATION_WEBSITE
  OTHER
}

enum EntityType {
  LOCAL_NGO
  INTL_NGO
  FOUNDATION
  UN_AGENCY
  GOVERNMENT
  CBO
}

enum EmploymentType {
  FULL_TIME   @map("Full-time")
  PART_TIME   @map("Part-time")
  CONTRACT    @map("Contract")
  CONSULTANCY @map("Consultancy")
  INTERNSHIP  @map("Internship")
}

enum ExperienceLevel {
  ENTRY     @map("Entry")
  MID_LEVEL @map("Mid-Level")
  SENIOR    @map("Senior")
  EXECUTIVE @map("Executive")
}

// ==========================================
// USER & ACCESS MANAGEMENT
// ==========================================

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  fullName     String  @map("full_name")
  passwordHash String? @map("password_hash")
  googleId     String? @unique @map("google_id")
  avatarUrl    String? @map("avatar_url")
  bio          String? @db.Text
  role         Role    @default(REGISTERED_USER)
  isActive     Boolean @default(true) @map("is_active")

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  bookmarks     Bookmark[]
  notifications Notification[]
  auditLogs     AuditLog[]

  // Author tracking inverse relations
  createdArticles      Article[]      @relation("ArticleCreator")
  updatedArticles      Article[]      @relation("ArticleUpdater")
  createdOpportunities Opportunity[]  @relation("OpportunityCreator")
  updatedOpportunities Opportunity[]  @relation("OpportunityUpdater")
  createdOrganizations Organization[] @relation("OrganizationCreator")
  updatedOrganizations Organization[] @relation("OrganizationUpdater")
  createdProjects      Project[]      @relation("ProjectCreator")
  updatedProjects      Project[]      @relation("ProjectUpdater")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // e.g., CREATE, UPDATE, DELETE, SUSPEND, RESTORE
  entity    String // e.g., Article, Organization, Opportunity, User
  entityId  String?  @map("entity_id")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ==========================================
// MASTER GEOGRAPHY & TAXONOMIES
// ==========================================

model Region {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  countries Country[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("regions")
}

model Country {
  id            String         @id @default(uuid())
  name          String         @unique
  slug          String         @unique
  code          String         @unique // ISO 2-letter e.g. "UG", "KE"
  regionId      String         @map("region_id")
  region        Region         @relation(fields: [regionId], references: [id], onDelete: Restrict)
  organizations Organization[]
  articles      Article[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("countries")
}

model Sector {
  id                  String               @id @default(uuid())
  name                String               @unique
  slug                String               @unique
  description         String?              @db.Text
  isActive            Boolean              @default(true) @map("is_active")
  organizationSectors OrganizationSector[]
  opportunities       Opportunity[]
  articles            Article[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@map("sectors")
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  slug          String        @unique
  isActive      Boolean       @default(true) @map("is_active")
  articles      Article[]
  opportunities Opportunity[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("categories")
}

model Tag {
  id            String        @id @default(uuid())
  name          String        @unique
  slug          String        @unique
  articles      Article[]     @relation("ArticleTags")
  opportunities Opportunity[] @relation("OpportunityTags")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("tags")
}

// ==========================================
// ORGANIZATIONS (MANY-TO-MANY SECTORS)
// ==========================================

model Organization {
  id             String     @id @default(uuid())
  name           String     @unique
  slug           String     @unique
  headquarters   String?
  type           EntityType
  logoUrl        String?    @map("logo_url")
  isVerified     Boolean    @default(false) @map("is_verified")
  registrationNo String?    @map("registration_no")
  description    String     @db.Text
  website        String?

  // Status and Soft Delete Support
  status    Status    @default(ACTIVE)
  deletedAt DateTime? @map("deleted_at")

  // Location / Country Relation
  countryCode String?  @map("country_code")
  countryId   String?  @map("country_id")
  country     Country? @relation(fields: [countryId], references: [id], onDelete: Restrict)
  region      String?

  // Relations
  sectors       OrganizationSector[]
  members       User[]
  opportunities Opportunity[]
  projects      Project[]
  events        Event[]
  volunteerings Volunteering[]

  // Author Tracking
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("OrganizationUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

model OrganizationSector {
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  sectorId String @map("sector_id")
  sector   Sector @relation(fields: [sectorId], references: [id], onDelete: Restrict)

  @@id([organizationId, sectorId])
  @@map("organization_sectors")
}

// ==========================================
// OPPORTUNITIES (UNIFIED JOBS, GRANTS, ETC.)
// ==========================================

model Opportunity {
  id String @id @default(uuid())

  // Base / Fallback fields (usually English)
  title       String
  slug        String          @unique
  type        OpportunityType // JOB, GRANT, SCHOLARSHIP, VOLUNTEER, TENDER
  summary     String          @db.Text
  description String          @db.Text
  location    String

  // Multilingual translations stored as JSONB
  // Structure: { "fr": "...", "es": "...", "pt": "...", "ar": "..." }
  titleTranslations       Json? @map("title_translations")
  summaryTranslations     Json? @map("summary_translations")
  descriptionTranslations Json? @map("description_translations")

  // Job / Grant Attributes
  employmentType   EmploymentType?  @map("employment_type")
  experienceLevel  ExperienceLevel? @map("experience_level")
  responsibilities String[] // Native text array
  qualifications   String[] // Native text array

  // Application & Provenance Routing
  applicationEmail  String?           @map("application_email")
  applicationUrl    String?           @map("application_url")
  sourceUrl         String?           @map("source_url")
  applicationMethod ApplicationMethod @default(EXTERNAL_URL) @map("application_method")

  verified Boolean @default(false)

  // Lifecycle & Expiry Management
  deadline  DateTime?
  expiresAt DateTime? @map("expires_at")
  amountUSD Decimal?  @map("amount_usd") @db.Decimal(12, 2)

  status    Status    @default(ACTIVE)
  deletedAt DateTime? @map("deleted_at")

  // Relations
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  sectorId String @map("sector_id")
  sector   Sector @relation(fields: [sectorId], references: [id], onDelete: Restrict)

  tags Tag[] @relation("OpportunityTags")

  // Author Tracking
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("OpportunityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("OpportunityUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, type, expiresAt])
  @@map("opportunities")
}

// ==========================================
// ARTICLES & NEWS (CANONICAL)
// ==========================================

model Article {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  excerpt       String?   @db.Text
  content       String    @db.Text
  aiSummary     String?   @map("ai_summary") @db.Text
  featuredImage String?   @map("featured_image")
  source        String?
  author        String?
  publishedDate DateTime? @map("published_date")
  publishedAt   DateTime? @map("published_at")
  isTrending    Boolean   @default(false) @map("is_trending")

  // Metadata & Geography
  countryCode String?  @map("country_code")
  countryId   String?  @map("country_id")
  country     Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  region      String?

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  sectorId String @map("sector_id")
  sector   Sector @relation(fields: [sectorId], references: [id], onDelete: Restrict)

  status    Status    @default(DRAFT)
  deletedAt DateTime? @map("deleted_at")

  tags Tag[] @relation("ArticleTags")

  // Author Tracking
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ArticleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("ArticleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("articles")
}

// ==========================================
// USER INTERACTIONS & SYSTEM ASSETS
// ==========================================

model Bookmark {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId   String   @map("entity_id")
  entityType String   @map("entity_type") // "ARTICLE" | "OPPORTUNITY" | "ORG"
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("bookmarks")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model Project {
  id          String @id @default(uuid())
  title       String
  slug        String @unique
  description String @db.Text
  latitude    Float?
  longitude   Float?

  status    Status    @default(ACTIVE)
  deletedAt DateTime? @map("deleted_at")

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Author Tracking
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("ProjectUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

model ContactInfo {
  id           String   @id @default(uuid())
  headquarters String   @default("Kampala, Uganda")
  email        String   @default("tuduluugandalimited@gmail.com")
  phone        String   @default("+256 750 692 621")
  updatedAt    DateTime @updatedAt
}

// ==========================================
//              EVENTS
// ==========================================

enum EventType {
  WEBINAR
  WORKSHOP
  CONFERENCE
  NETWORKING
  SUMMIT
}

model Event {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  description    String        @db.Text
  location       String?
  isVirtual      Boolean       @default(false)
  eventUrl       String?
  startDate      DateTime
  endDate        DateTime?
  type           EventType     @default(CONFERENCE)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("events")
}

// ==========================================
//              VOLUNTEERING
// ========================================== 

model Volunteering {
  id             String       @id @default(uuid())
  title          String
  slug           String       @unique
  description    String
  commitment     String?
  location       String?
  isRemote       Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

//==========================================
// NEWS LETTERS
//+=========================================
model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}